# Database Configuration
DATABASE_URL="mysql://username:password@localhost:3306/dnd_form_db"

# App Mode
USE_MOCK_DATA=false

# Authentication / JWT (At least 32 characters)
JWT_SECRET="your_super_secret_jwt_key_dnd_form"

# Super Admin Initial Account (For db:seed)
SUPER_ADMIN_FULL_NAME="Super Admin"
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="your_secure_password_here"

# ======================
# Storage Configuration
#=======================
# 'local' lưu ở disk hoặc 's3' lưu ở cloud (RustFS / Cloudflare R2,...)
STORAGE_DRIVER=local

# [Driver local]
LOCAL_STORAGE_DIR=storage/uploads
LOCAL_PUBLIC_URL=/api/files

# [Driver s3] - S3_PUBLIC_URL là BẮT BUỘC khi STORAGE_DRIVER=s3
S3_BUCKET=dragform-media
S3_REGION=auto
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=myrustfsadmin
S3_SECRET_ACCESS_KEY=myrustfsadmin_pass
S3_PUBLIC_URL=http://localhost:9000/dragform-media